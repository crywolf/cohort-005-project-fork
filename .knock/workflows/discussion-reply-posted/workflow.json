{
  "name": "Discussion reply posted",
  "description": "Someone replied to the recipient's question in a lesson discussion.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "/courses/{{ data.courseSlug }}/lessons/{{ data.lessonId }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "categories": [
    "discussion-activity"
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "discussion-reply-posted",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
