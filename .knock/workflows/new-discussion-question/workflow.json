{
  "name": "New discussion question",
  "description": "A student posted a new question on one of the instructor's lessons.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "/instructor/{{ data.courseId }}/lessons/{{ data.lessonId }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "categories": [
    "discussion-activity"
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "new-discussion-question",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
